NS_COOKIE=如果本地调试这里填你的cookie

# 除签到外的任务（评论、加鸡腿）总开关，默认 false 即只签到
# 设为 true 才会执行评论和加鸡腿，开启前建议先改 randomInputStr 里的随机词
NS_EXTRA_TASKS=false

# DeepFlood 子站 cookie（可选，配置后两站顺序签到，中间自动随机延迟）
DEEPFLOOD_COOKIE=

# linux.sb（烧饼社区）签到 cookie（可选，配置后 NodeSeek、DeepFlood 完成后追加签到）
# 多账号用 & 分隔（cookie1&cookie2），依次签到、单账号失败不中断
LINUXSB_COOKIE=

# 多站签到间随机延迟范围（秒，默认 60-180）
SITE_GAP_MIN=60
SITE_GAP_MAX=180

# 通知渠道配置，按需填写，留空即跳过该渠道

# Telegram Bot 推送
TG_BOT_TOKEN=
TG_USER_ID=
# 可选：自建反代地址与 HTTP 代理
TG_API_HOST=
TG_PROXY=

# 企业微信群机器人（最简单，推荐）
WECOM_WEBHOOK=

# 企业微信自建应用推送
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=
# 可选：接收成员，默认 @all
WECOM_TOUSER=
